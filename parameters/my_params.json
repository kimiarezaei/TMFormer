{
    "architecture": "CNN-transformer",
    "learning_rate": 0.01,
    "warmup_period": 20,
    "eta_min": 1e-06,
    "batch_size": 1024,
    "epochs": 200,
    "random_seed": 42,
    "initialization": "he",
    "use_wandb": true,
    "scheduler": true,
    "apply_early_stop": true,
    "stop_threshold": 5,
    "kernel_size": 800,
    "embedding_dim": 256,
    "stride": 700,
    "num_heads": 8,
    "num_blks": 2,
    "drop_out_stoch": 0.3,
    "drop_out_att": 0.2,
    "weight_decay": 1e-05,
    "signal_length": 19200,
    "train_portion": 0.8
}